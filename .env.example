# URL de votre Google Apps Script Web App
# Obtenez cette URL dans Google Sheets → Extensions → Apps Script → Déployer
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/VOTRE_ID/exec

# Clé API secrète (doit être identique dans le script Google Apps Script)
# Générez une clé aléatoire de 32+ caractères
VITE_API_KEY=votre_cle_api_secrete
